# Gemini configuration used by the teacher web AI quiz generator.
# Restrict this browser API key to your Firebase Hosting domains and the
# Generative Language API in Google Cloud Console before deployment.
VITE_GEMINI_API_KEY=your_restricted_gemini_api_key

# Optional. When omitted, the portal discovers available generateContent
# models from the Gemini ListModels endpoint and prefers a Flash model.
VITE_GEMINI_MODEL=
